- To produce a Windows version, the path separator must be determined. Possibilities are

  call get_command_argument(0, length=arg0_length, status=istat)
  allocate(character(len=arg0_length) :: arg0)
  call get_command_argument(0, arg0, status=istat)
  ! check argument name
  if( index(arg0, '\').ne.0 ) then
    sep='\'
  else if( index(arg0, '/' ).ne.0 ) then
    sep='/'
  end if
  (see https://fpm.fortran-lang.org/proc/separator.html, but this may not work if the
  executable was in the search path)
  
  or
  
  function unix() result(is_unix)
    logical :: is_unix
    character (len=100) :: path
    call get_environment_variable("PATH", path)
    is_unix = path(1:1) == "/"
  end function unix 

  or
  
  #ifdef _WIN32
    os = 'Windows'
  #else
    os = 'Linux'
  #endif
  
  or
  
  (maybe more robust:) Introduce a constant and change it before compilation!
  
