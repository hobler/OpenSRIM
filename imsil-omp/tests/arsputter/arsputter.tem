Sputtering of a-Si, static mode
Ar on a-Si, 10keV, #tilt# tilt
 &setup    ndim=1 natom=2 nr=1 ldyn=f lsput=t nion=100000 /
 &ions     name='Ar' energy=10 dose=1 tilt=#tilt# diverg=0 /
 &material region=1 name='Si' xtal='no' /
 &snpar    chkffpcyl=t /
 &nosnpar    etime=0 /
 &nosnpar    ef=15 denffp=15 etime=0 /
 &damage   ldam=f lrcoil=t esurf=4.1 ed=15 /
 &geometry posif=0,1000 /
 &output   lhis=t wboxi=20 nbox=200 lmomab=t lhisab=t wboxai=1 /
 