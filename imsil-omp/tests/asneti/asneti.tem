NetI calculation for #sub#amorphizing dose
 
 &setup    natom=3 nr=2 nion=100000 nionhis=800 /
 &ions     name='As' energy=10 dose=#dose# tilt=7 rotate=15 diverg=0.3 /
 &material region=1 name='SiO2' xtal='no' /
 &material region=2 name='Si' xtal='yes' /
 &snpar    ef=10 lstffp=f /
 &crystal  pmax=2.43 /
 &damage   ldam=t frec=1 damamo=2.7e22 lcap=t rcap=3.84
           lrcoil=t lamzon=f /
 &geometry posif=-10,0,100000 /
 &output   lmom=t lhis=t nbox=1000 
           lhisiv=t wboxd=3.84 nboxd=1000
           posivmin=0 posivmax=100000 
           lhis2=t lcyl=t /
 
