Boron implantation into <100> silicon with a SiO2 layer
e=20keV tilt=7 rotate=15 T=300 ions=1000000 tsio2=10A   
 &setup    ndim=2 natom=3 nr=2 nion=1000000 /
 &ions     name='B' energy=20 dose=1e16 tilt=7 rotate=15 diverg=0
           xwin=-2000,0 /
 &material region=1 name='SiO2' xtal='no' /
 &material region=2 name='Si' xtal='yes' /
 &snpar    lstffp=f /
 &snpar    atom1=1 atom2=2 scatfile='BSI' /
 &snpar    atom1=1 atom2=3 scatfile='BO' /
 &geometry bndtypex='periodic' /
 &geometry point=1 pos=-2000,0 /
 &geometry point=2 pos=-2000,10 /
 &geometry point=3 pos=-2000,4000 /
 &geometry point=4 pos=0,4000 /
 &geometry point=5 pos=0,10 /
 &geometry point=6 pos=0,0 /
 &nogeometry region=0 points=1,2,3,4,5,6 /
 &geometry region=1 points=1,2,5,6 /
 &geometry region=2 points=2,3,4,5 /
 &output   lmom=t lhis=t 
           lhis2=t lperx=t /

