Range profile calculation to fit the electronic stopping power
Data from Soitec (Feb 2004), #energy# keV, straggle=#straggle#, Note: powint(O) not fitted
 
 &setup    natom=3 nr=2 nion=10000 nionhis=80 /
 &ions     name='H' energy=#energy# dose=#dose# tilt=#tilt# rotate=22 diverg=0.3 /
 &material region=1 name='SiO2' xtal='no' /
 &material region=2 name='Si' xtal='yes' wafer=1,1,0 vsurf=0,0,1 /
 &snpar    ef=10 lstffp=f /

 &separ    atom1=1 atom2=2 corlin=1.68 powint=0.81 c0bethe=1.7 c1bethe=3.785
           xnl=0.35,0.2 facscr=1.37 /
 &separ    atom1=1 atom2=3 corlin=0.45 powint=0.9 /
 &separ    straggle=#straggle# estrag=10000 /

 &damage   ldam=t lrcoil=f /
 &geometry posif=-20,0,100000 /
 &output   lmom=t lhis=t wboxi=#wboxi# nbox=100 /
 
