param[fname]['usecell'] = 't'
param[fname]['cellfile'] = 'krdyn_9e15.cell'
param[fname]['grid'] = 'rectilinear'
param[fname]['ldyn'] = 't'
param[fname]['natom'] = '2'
param[fname]['nion'] = '10000'
param[fname]['atom1'] = '1'

fname = 'krdyn_10e15_stat'
param[fname] = {}
param[fname]['usecell'] = 't'
param[fname]['cellfile'] = 'krdyn_10e15.cell'
param[fname]['grid'] = 'rectilinear'
param[fname]['ldyn'] = 'f'
param[fname]['natom'] = '3'
param[fname]['nion'] = '10000'
param[fname]['atom1'] = '2'

