Round Robin Simulation similar to COSIRES'94
Pmax=2.715A, 6x6x2 unit cells, #text#-Si, #tilt# tilt
 &setup    natom=2 nr=1 nion=100000 /
 &ions     name='B' energy=0.2 tilt=#tilt# / lmd=#lmd# 
 &material region=1 name='Si' xtal='yes' density=4.997e22  
           vsurf=#vsurf# wafer=#wafer# vib=0.0 /
 &snpar    ef=20.0 scatfile='ZBLuniv' /
 &crystal  nrad2=4 pmax=2.0 nloldm=6 psoldm=30.0 ffoldm=0.5  
           ffpmax=1.0 /  ! was ffpmax=0.95 ffpmin=0.05 ffpsim=0.295 /
 &damage   ldam=f esurf=1e-30 /
 &separ    semodel='none' /
 &geometry posif=-0.1,11.0 lrobin=#lrobin# /
 &output   lmomet=t lmomaat=t lhiset=t lhisaat=t 
           lmomeb=t lmomaab=t lhiseb=t lhisaab=t 
           nboxa=0 nboxe=0 epower=1 wboxe=2 /
 